# 生产环境配置
VITE_API_URL=https://de1.api.radio-browser.info
VITE_FALLBACK_API_URLS=https://us1.api.radio-browser.info,https://nl1.api.radio-browser.info

# 应用配置
VITE_APP_NAME=全球电台
VITE_APP_VERSION=2.0.0

# 缓存配置
VITE_CACHE_TTL=300
VITE_MAX_HISTORY=1000
VITE_MAX_FAVORITES=500

# 功能开关
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CRASH_REPORTING=true
VITE_ENABLE_PWA=true

# API超时配置
VITE_API_TIMEOUT=10000
VITE_API_RETRY_COUNT=3
