{
  "name": "global-radio",
  "version": "2.0.0",
  "description": "跨平台全球电台收听应用",
  "author": "GlobalRadio Team",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:electron": "vite build --config vite.electron.config.ts && electron-builder",
    "build:android": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "build:docker": "docker build -f docker/Dockerfile -t global-radio:latest .",
    "preview": "vite preview",
    "electron:dev": "vite --config vite.electron.config.ts",
    "electron:build": "npm run build:electron",
    "capacitor:sync": "npx cap sync",
    "capacitor:open": "npx cap open",
    "version:check": "node scripts/check-version.js",
    "release": "npm run build && npm run build:electron && npm run build:android"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "@capacitor/device": "^5.0.8",
    "@capacitor/haptics": "^5.0.8",
    "@capacitor/keyboard": "^5.0.9",
    "@capacitor/status-bar": "^5.0.8",
    "@headlessui/vue": "^1.7.16",
    "@heroicons/vue": "^2.0.18",
    "@jofr/capacitor-media-session": "^3.0.3",
    "@vueuse/core": "^10.5.0",
    "axios": "^1.6.2",
    "electron-updater": "^6.1.7",
    "pinia": "^2.1.7",
    "vue": "^3.3.11",
    "vue-i18n": "^9.9.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.8",
    "@types/node": "^20.10.5",
    "@vitejs/plugin-vue": "^4.5.2",
    "autoprefixer": "^10.4.16",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^1.0.0",
    "vue-tsc": "^3.2.1"
  }
}
