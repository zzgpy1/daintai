{
  "name": "global-radio",
  "version": "2.0.0",
  "description": "全球电台 - 聆听世界，音乐无界",
  "author": "GlobalRadio Team",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "build:android": "npm run build && npx cap sync android && npx cap copy android && cd android && ./gradlew assembleRelease",
    "build:docker": "docker build -f docker/Dockerfile -t global-radio:latest .",
    "preview": "vite preview",
    "electron:dev": "vite build --mode development && electron electron/main.ts",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "capacitor:init": "npx cap init",
    "capacitor:add-android": "npx cap add android",
    "capacitor:sync": "npx cap sync",
    "capacitor:open": "npx cap open",
    "docker:build": "docker build -f docker/Dockerfile -t superneed/global-radio:latest .",
    "docker:push": "docker push superneed/global-radio:latest",
    "release": "node scripts/release.js",
    "update-version": "node scripts/update-version.js"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "@capacitor/device": "^5.0.8",
    "@capacitor/haptics": "^5.0.8",
    "@capacitor/keyboard": "^5.0.9",
    "@capacitor/status-bar": "^5.0.8",
    "@headlessui/vue": "^1.7.16",
    "@heroicons/vue": "^2.0.18",
    "@jofr/capacitor-media-session": "^3.0.3",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-i18n": "^9.9.0",
    "vue-router": "^4.2.5",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.4.16",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-updater": "^6.1.7",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "terser": "^5.43.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-pwa": "^0.17.4",
    "vue-tsc": "^1.8.27"
  },
  "build": {
    "appId": "com.globalradio.app",
    "productName": "全球电台",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": ["nsis", "zip"],
      "icon": "electron/build/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "electron/build/icon.png",
      "category": "public.app-category.music"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
