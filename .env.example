# 应用配置
VITE_APP_NAME=全球电台
VITE_APP_VERSION=2.0.0

# API配置
VITE_API_BASE_URL=https://de1.api.radio-browser.info
VITE_API_TIMEOUT=10000
VITE_CACHE_TTL=300000

# 备用API提供商
VITE_FALLBACK_API_1=https://us1.api.radio-browser.info
VITE_FALLBACK_API_2=https://nl1.api.radio-browser.info
VITE_FALLBACK_API_3=https://fr1.api.radio-browser.info

# 功能开关
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CRASH_REPORTING=true
VITE_ENABLE_AUTO_UPDATE=true

# 调试模式
VITE_DEBUG=false
