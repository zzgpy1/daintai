# API 配置
VITE_RADIO_API_URL=https://de1.api.radio-browser.info
VITE_RADIO_API_TIMEOUT=10000

# RapidAPI Key (备用)
RAPID_API_KEY=your_rapidapi_key_here

# 缓存配置
VITE_CACHE_TTL=300000
VITE_MAX_CACHE_ENTRIES=100

# 应用配置
VITE_APP_NAME=全球电台
VITE_APP_VERSION=1.0.0
VITE_DEFAULT_LANGUAGE=zh

# 部署配置
VITE_API_BASE_URL=/api
VITE_CDN_URL=

# 功能开关
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_BACKGROUND_PLAY=true
